{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{src/views/**,public/**,node_modules/chart.js/dist/**,node_modules/@fontsource/montserrat/files/**,node_modules/flag-icons/flags/1x1/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
