<%- include('../partials/layout-start') %>

<section class="personalizar">
  <div class="card">
    <div class="card-head"><h2>Paletas prontas</h2><span class="hint">Clique para experimentar; depois ajuste cada cor se quiser.</span></div>
    <div class="paletas">
      <% paletas.forEach(p => { %>
        <button class="paleta" type="button" data-paleta="<%= p.id %>" aria-label="Usar a paleta <%= p.nome %>">
          <span class="paleta-cores" aria-hidden="true">
            <% campos.forEach(c => { %><span class="paleta-cor" data-cor="<%= p.cores[c.chave] %>"></span><% }) %>
          </span>
          <span class="paleta-nome"><%= p.nome %></span>
        </button>
      <% }) %>
    </div>
  </div>

  <div class="pers-grid">
    <div class="card">
      <div class="card-head"><h2>Suas cores</h2><span class="hint">A página muda enquanto você escolhe.</span></div>
      <form id="form-cores" class="pers-campos" novalidate>
        <% campos.forEach(c => { const atual = atuais[c.chave] || c.padrao; %>
          <div class="pers-campo">
            <div class="pers-texto">
              <label for="cor-<%= c.chave %>"><%= c.rotulo %></label>
              <span class="hint"><%= c.ajuda %></span>
            </div>
            <div class="pers-entrada">
              <input type="color" id="cor-<%= c.chave %>" data-chave="<%= c.chave %>" data-padrao="<%= c.padrao %>" value="<%= atual.toLowerCase() %>">
              <input class="input pers-hex" type="text" maxlength="7" spellcheck="false" autocomplete="off" aria-label="<%= c.rotulo %> em hexadecimal" data-hex="<%= c.chave %>" value="<%= atual.toUpperCase() %>">
              <button class="btn btn-ghost btn-sm" type="button" data-padrao-de="<%= c.chave %>" title="Voltar esta cor ao padrão">Padrão</button>
            </div>
          </div>
        <% }) %>
        <p class="pers-aviso" id="pers-contraste" hidden>Com essa cor principal, o texto branco dos botões pode ficar difícil de ler. Prefira um tom mais escuro.</p>
        <div class="pers-acoes">
          <button class="btn btn-ghost" type="button" id="pers-restaurar">Restaurar padrão</button>
          <button class="btn btn-primary" type="button" id="pers-salvar" disabled>Salvar cores</button>
        </div>
      </form>
    </div>

    <div class="card pers-previa" aria-label="Prévia das cores">
      <div class="card-head"><h2>Prévia</h2></div>
      <div class="previa-corpo">
        <div class="previa-menu"><span class="previa-pilula">Demonstração do Resultado</span><span class="previa-item">Capital Empregado</span></div>
        <h3 class="previa-titulo">Título de um card</h3>
        <div class="previa-kpis">
          <div class="previa-kpi"><span>Lucro líquido</span><strong class="pos">R$ 1,2 mi</strong></div>
          <div class="previa-kpi"><span>Resultado financeiro</span><strong class="neg">-R$ 340 mil</strong></div>
        </div>
        <div class="previa-linha"><button class="btn btn-primary" type="button" tabindex="-1">Botão principal</button><a href="#" class="previa-link" tabindex="-1">Um link</a><span class="badge ok">Carregado</span></div>
        <p class="hint">Valores fictícios, só para mostrar as cores.</p>
      </div>
    </div>
  </div>

  <% if (avatarAdmin) { const af = avatarForm, v = af.values || {}, er = af.errors || {}; %>
  <!-- Avatar comemorativo: imagem SVG (pode ser animada) que flutua para todos entre as datas -->
  <div class="grid grid-2 avatar-cad" id="avatar">
    <form class="card" method="post" action="/personalizar/avatar" enctype="multipart/form-data" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-head"><h2>Avatar comemorativo</h2><span class="hint">Aparece flutuando no canto da tela, para todos</span></div>
      <% if (af.flash) { %><div class="alert alert-ok"><%= af.flash %></div><% } %>
      <% if (af.error) { %><div class="alert alert-err"><%= af.error %></div><% } %>
      <div class="form-grid">
        <div class="field full <%= er.nome ? 'has-error' : '' %>">
          <label for="av-nome">Nome *</label>
          <input class="input" id="av-nome" name="nome" value="<%= v.nome || '' %>" maxlength="60" autocomplete="off" placeholder="Ex.: Natal">
          <% if (er.nome) { %><div class="field-error"><%= er.nome %></div><% } %>
        </div>
        <div class="field full <%= er.arquivo ? 'has-error' : '' %>">
          <label for="av-svg">Código SVG *</label>
          <textarea class="input avatar-codigo" id="av-svg" name="svgTexto" rows="5" spellcheck="false" autocomplete="off" placeholder="Cole aqui o código gerado pelo ChatGPT ou Claude (de <svg ... até </svg>)"><%= v.svgTexto || '' %></textarea>
          <div class="avatar-ou">
            <span>ou envie o arquivo:</span>
            <input class="input" id="av-arquivo" name="arquivo" type="file" accept=".svg,image/svg+xml" aria-label="Arquivo da imagem (.svg)">
          </div>
          <% if (er.arquivo) { %><div class="field-error"><%= er.arquivo %></div><% } else { %><div class="help">Até 300 KB. Pode ter animação (CSS ou SMIL), mas sem scripts nem links externos. Se colar o código e também enviar um arquivo, vale o código colado. <a class="avatar-exemplo" href="/static/img/comemorativos/arvore-natal.svg" download>Baixar exemplo: árvore de Natal com pisca-pisca</a></div><% } %>
        </div>
        <div class="field full avatar-previa" id="avatar-previa" hidden>
          <span class="avatar-previa-rotulo">Prévia</span>
          <img alt="Prévia do avatar" width="120" height="120">
          <span class="hint" data-previa-msg></span>
        </div>
        <div class="field <%= er.inicio ? 'has-error' : '' %>">
          <label for="av-inicio">Exibir a partir de *</label>
          <input class="input" id="av-inicio" name="inicio" type="date" value="<%= v.inicio || '' %>">
          <% if (er.inicio) { %><div class="field-error"><%= er.inicio %></div><% } %>
        </div>
        <div class="field <%= er.fim ? 'has-error' : '' %>">
          <label for="av-fim">Exibir até *</label>
          <input class="input" id="av-fim" name="fim" type="date" value="<%= v.fim || '' %>">
          <% if (er.fim) { %><div class="field-error"><%= er.fim %></div><% } %>
        </div>
      </div>
      <div class="msg-form-actions"><button class="btn btn-primary" type="submit">Cadastrar avatar</button></div>
    </form>

    <div class="card">
      <div class="card-head"><h2>Avatares cadastrados</h2><span class="hint"><%= avatares.filter(a => a.situacao === 'No ar').length %> no ar</span></div>
      <% if (!avatares.length) { %>
        <p class="hint">Nenhum avatar cadastrado ainda.</p>
      <% } else { %>
        <ul class="avatar-lista">
          <% avatares.forEach(a => { %>
            <li class="avatar-item">
              <img src="/avatar/<%= a.id %>.svg?v=<%= encodeURIComponent(a.updatedAt || '') %>" alt="" loading="lazy">
              <div class="avatar-info">
                <strong><%= a.nome %></strong>
                <span class="hint"><span class="msg-sit <%= a.situacao === 'No ar' ? 'on' : 'off' %>"><%= a.situacao %></span> · de <%= a.inicio.split('-').reverse().join('/') %> até <%= a.fim.split('-').reverse().join('/') %></span>
              </div>
              <form method="post" action="/personalizar/avatar/<%= a.id %>/excluir" data-confirm="Excluir o avatar <%= a.nome %>?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-danger-outline btn-sm" type="submit">Excluir</button>
              </form>
            </li>
          <% }) %>
        </ul>
        <p class="hint">Se dois avatares estiverem no ar ao mesmo tempo, aparece o cadastrado por último.</p>
      <% } %>
    </div>
  </div>
  <% } %>
</section>
<script type="application/json" id="pers-dados"><%- JSON.stringify({ paletas: paletas.map(p => ({ id: p.id, cores: p.cores })), menu, menuPadrao }).replace(/</g, '\\u003c') %></script>

<%- include('../partials/layout-end') %>
