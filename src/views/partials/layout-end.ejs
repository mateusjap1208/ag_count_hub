    </main>
    <% const msgs = locals.mensagensRodape || []; if (msgs.length) { %>
    <!-- Faixa de mensagens no rodapé (cadastro em Mensagens): passa como as cotações num telejornal -->
    <div class="ticker" role="marquee" aria-label="Avisos">
      <div class="ticker-label"><%- include('icon', { name: 'megaphone' }) %><span>Avisos</span></div>
      <div class="ticker-viewport">
        <div class="ticker-track" data-ticker>
          <% [0, 1].forEach(copia => { %>
            <ul class="ticker-group" <%- copia ? 'aria-hidden="true"' : '' %>>
              <% msgs.forEach(m => { %><li class="ticker-item"><span class="ticker-dot msg-<%= m.tipo %>" aria-hidden="true"></span><%= m.texto %></li><% }) %>
            </ul>
          <% }) %>
        </div>
      </div>
    </div>
    <% } %>
  </div>
</div>

<% if ((locals.novidades && locals.novidades.pendente) && currentPath !== '/novidades') { %>
<!-- Aviso de nova versão publicada (some ao clicar em "Entendi") -->
<aside class="notif-toast" id="notif-toast" role="status" aria-live="polite" data-versao="<%= locals.novidades.atual %>">
  <div class="notif-head">
    <span class="notif-icon" aria-hidden="true"><%- include('icon', { name: 'sparkle' }) %></span>
    <div>
      <strong>Nova atualização publicada</strong>
      <span class="notif-ver">Versão <%= locals.novidades.atual %></span>
    </div>
  </div>
  <div class="notif-body">
    <% locals.novidades.novas.slice(0, 3).forEach(n => { %>
      <p class="notif-title"><%= n.titulo %> <span class="notif-ver"><%= n.versao %></span></p>
      <ul><% n.itens.forEach(i => { %><li><%= i %></li><% }) %></ul>
    <% }) %>
    <% if (locals.novidades.novas.length > 3) { %><p class="notif-more">e mais <%= locals.novidades.novas.length - 3 %> versão(ões) com novidades.</p><% } %>
  </div>
  <form method="post" action="/novidades/visto" class="notif-actions" data-notif-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="voltar" value="<%= currentPath %>">
    <a class="btn btn-ghost" href="/novidades">Ver todas</a>
    <button class="btn btn-primary" type="submit">Entendi</button>
  </form>
</aside>
<% } %>

<% const av = locals.avatarFlutuante; if (av) { %>
<!-- Avatar comemorativo (cadastro em Personalizar): flutua no canto; cada pessoa pode fechar -->
<% const avSrc = '/avatar/' + av.id + '.svg?v=' + encodeURIComponent(av.updatedAt || ''); %>
<aside class="avatar-flutuante" id="avatar-flutuante" data-avatar-id="<%= av.id %>" aria-label="<%= av.nome %>" hidden>
  <button class="avatar-abrir" type="button" data-avatar-abrir aria-label="Ampliar o avatar <%= av.nome %>" title="Clique para ampliar">
    <img src="<%= avSrc %>" alt="<%= av.nome %>" width="120" height="120" draggable="false">
  </button>
  <button class="avatar-fechar" type="button" data-avatar-fechar aria-label="Fechar o avatar <%= av.nome %>" title="Fechar">&times;</button>
</aside>
<!-- Avatar ampliado no centro da tela (clique no avatar); fecha com Esc, no X ou clicando fora -->
<dialog class="avatar-zoom" id="avatar-zoom" aria-label="<%= av.nome %>">
  <img src="<%= avSrc %>" alt="<%= av.nome %>" draggable="false">
  <button class="avatar-zoom-fechar" type="button" data-avatar-zoom-fechar aria-label="Fechar a imagem ampliada" title="Fechar">&times;</button>
</dialog>
<% } %>

<!-- Aviso: arquivo sem competência no nome (uploads) -->
<dialog class="modal" id="competencia-dialog" aria-labelledby="cd-title" aria-describedby="cd-text">
  <div class="modal-icon" aria-hidden="true"><%- include('icon', { name: 'clock' }) %></div>
  <h2 id="cd-title">Competência não encontrada no nome do arquivo</h2>
  <p id="cd-text">O nome do arquivo <strong data-cd-file></strong> precisa ter a competência (mês e ano), por exemplo <code>ZL0190 - ESTOQUE_10.2026.xlsx</code> ou <code>FGI0 - Moeda da empresa 31.10.2026.xlsx</code>.</p>
  <p class="note">Renomeie o arquivo ou informe a competência no campo destacado.</p>
  <form method="dialog" class="modal-actions"><button class="btn btn-primary" value="ok" autofocus>Informar a competência</button></form>
</dialog>
<% if (typeof chartData !== 'undefined' && chartData) { %>
<script type="application/json" id="page-data"><%- JSON.stringify(chartData).replace(/</g, '\\u003c') %></script>
<script src="/vendor/chart.js/chart.umd.min.js"></script>
<% } %>
<% if (locals.user) { %><script type="application/json" id="user-prefs"><%- JSON.stringify({ ordem: user.ordem || {}, csrf: csrfToken, admin: user.role === 'admin' }).replace(/</g, '\\u003c') %></script><% } %>
<script src="/static/js/app.js?v=<%= appVersion %>"></script>
</body>
</html>
