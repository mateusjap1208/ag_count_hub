<%- include('head', { title }) %>
<div class="app">
<%
  const navItem = (href, icon, label, active) =>
    `<a href="${href}" class="nav-item${active ? ' active' : ''}"${active ? ' aria-current="page"' : ''}>` +
    `<span class="nav-icon">${include('icon', { name: icon })}</span><span class="nav-text">${label}</span></a>`;
%>
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <span class="brand-mini" aria-hidden="true"><%- include('icon', { name: 'menu' }) %></span>
      <img class="brand-logo logo-pos" src="/static/img/logo-consag.png" alt="CONSAG Engenharia">
      <img class="brand-logo logo-neg" src="/static/img/logo-consag-negativo.png" alt="CONSAG Engenharia">
      <div class="brand-text"><strong>AG Cont Hub</strong><span>Dashboard Contábil</span></div>
    </div>
    <nav class="nav" aria-label="Menu principal">
      <%- navItem('/', 'home', 'Visão Geral', currentPath === '/') %>
      <hr class="nav-sep"><div class="nav-label">Relatórios</div>
      <% // Ordem do menu (só a navegação; módulos fora da lista vão para o fim, na ordem original)
         const ORDEM_MENU = ['bp', 'dre', 'capital-empregado', 'clientes', 'adiantamentos', 'estoque', 'seguros-garantias', 'imobilizado', 'fornecedores', 'receita-poc', 'arrendamento'];
         const posMenu = (m) => { const i = ORDEM_MENU.indexOf(m.slug); return i < 0 ? ORDEM_MENU.length : i; };
         const itensMenu = menu.filter(m => !m.hideInMenu).map((m, i) => ({ m, i })).sort((a, b) => posMenu(a.m) - posMenu(b.m) || a.i - b.i).map(x => x.m); %>
      <% itensMenu.forEach(m => {
           const ativo = (m.tabs || [{ slug: m.slug }]).some(t => currentPath === '/modulos/' + t.slug); %>
        <%- navItem('/modulos/' + m.slug, m.icon, m.menu, ativo) %>
        <% if (m.slug === 'dre') { %><%- navItem('/indicadores', 'gauge', 'Indicadores', currentPath === '/indicadores') %><% } %>
      <% }) %>
      <% if (user.role === 'admin') { %>
        <hr class="nav-sep"><div class="nav-label">Dados</div>
        <%- navItem('/upload', 'upload', 'Upload de relatórios', currentPath === '/upload') %>
        <%- navItem('/obras', 'hardhat', 'Obras', currentPath.startsWith('/obras')) %>
        <%- navItem('/parametros', 'database', 'Parâmetros', currentPath.startsWith('/parametros')) %>
        <%- navItem('/usuarios', 'lock', 'Usuários', currentPath.startsWith('/usuarios')) %>
        <%- navItem('/mensagens', 'megaphone', 'Mensagens', currentPath.startsWith('/mensagens')) %>
        <%- navItem('/pendencias', 'alerta', 'Pendências', currentPath.startsWith('/pendencias')) %>
      <% } %>
      <hr class="nav-sep"><div class="nav-label">Sistema</div>
      <%- navItem('/novidades', 'sparkle', 'Novidades', currentPath === '/novidades') %>
      <%- navItem('/sobre', 'info', 'Sobre', currentPath === '/sobre') %>
    </nav>
    <div class="sidebar-foot">
      <p class="app-version" title="Versão do sistema"><%= appVersion %></p>
    </div>
  </aside>

  <div class="main">
    <header class="topbar">
      <button class="icon-btn menu-toggle" type="button" id="menu-toggle" aria-label="Abrir menu"><%- include('icon', { name: 'menu' }) %></button>
      <div>
        <h1><%= title %></h1>
        <% if (locals.hideFilters) { %>
          <div class="subtitle"><%= locals.subtitle || 'Administração de dados' %></div>
        <% } else { %>
          <div class="subtitle"><%= companyName %> · <%= filter.periodo ? fmt.periodFull(filter.periodo) : 'sem dados carregados' %></div>
        <% } %>
      </div>
      <div class="spacer"></div>
      <% const pend = locals.pendencias; if (pend && pend.total) { %>
      <a class="pend-alerta" href="/pendencias" title="<%= pend.resumo.join(' · ') %>" aria-label="Pendências de parâmetros: <%= pend.resumo.join(', ') %>">
        <%- include('icon', { name: 'alerta' }) %>
        <span class="pend-badge" aria-hidden="true"><%= pend.total %></span>
      </a>
      <% } %>
      <a class="notif-bell <%= (locals.novidades && locals.novidades.pendente) ? 'has-new' : '' %>" href="/novidades" title="<%= (locals.novidades && locals.novidades.pendente) ? 'Nova atualização: ' + locals.novidades.atual : 'Novidades do sistema' %>" aria-label="Novidades<%= (locals.novidades && locals.novidades.pendente) ? ' (nova atualização)' : '' %>">
        <%- include('icon', { name: 'bell' }) %>
        <% if ((locals.novidades && locals.novidades.pendente)) { %><span class="notif-dot" aria-hidden="true"></span><% } %>
      </a>
      <% if (typeof hideFilters === 'undefined' || !hideFilters) {
           // Filtros de obra/empresa em uso (mostrados no selo do botão)
           const filtrosAtivos = ['estrutura', 'sigla', 'empresa', 'centro'].filter(k => (filter[k] || []).length).length; %>
      <div class="filters-wrap" id="filters-wrap">
        <button class="filters-toggle" type="button" id="filters-toggle" aria-controls="filters-panel" aria-expanded="false" title="Filtros">
          <%- include('icon', { name: 'filter' }) %>
          <span class="filters-toggle-text">Filtros</span>
          <% if (filtrosAtivos) { %><span class="filters-badge" aria-label="<%= filtrosAtivos %> filtro(s) ativo(s)"><%= filtrosAtivos %></span><% } %>
        </button>
        <div class="filters-panel" id="filters-panel">
      <form class="filters" method="get" id="filters">
        <%
          // Seleção múltipla: o campo oculto vazio garante que "nenhum marcado" limpe o filtro
          const sel = (lista, v) => (lista || []).includes(v) ? 'selected' : '';
          const campos = [
            { name: 'estrutura', label: 'Estrutura', todos: 'Todas as estruturas', plural: 'estruturas', opts: filterOpts.estruturas.map(e => [e, e]) },
            { name: 'sigla', label: 'Sigla', todos: 'Todas as siglas', plural: 'siglas', opts: filterOpts.siglas.map(x => [x, x]) },
            { name: 'empresa', label: 'Empresa', todos: (filter.estrutura.length || filter.sigla.length) ? `Todas as empresas (${companies.length})` : 'Consolidado do grupo', plural: 'empresas', opts: companies.map(c => [c.code, fmt.company(c)]) },
            { name: 'centro', label: 'Centro de lucro', todos: `Todos os centros (${fmt.number(filterOpts.centros.length)})`, plural: 'centros', opts: filterOpts.centros.map(c => [c.code, c.code + (c.siglaObra && c.siglaObra !== c.code ? ' · ' + c.siglaObra : '')]) },
          ];
        %>
        <% campos.forEach(c => { %>
        <div>
          <label for="f-<%= c.name %>"><%= c.label %></label>
          <input type="hidden" name="<%= c.name %>" value="">
          <select class="select" name="<%= c.name %>" id="f-<%= c.name %>" multiple data-enhance="multi" data-todos="<%= c.todos %>" data-plural="<%= c.plural %>" size="1">
            <% c.opts.forEach(([v, t]) => { %><option value="<%= v %>" <%= sel(filter[c.name], v) %>><%= t %></option><% }) %>
          </select>
        </div>
        <% }) %>
        <div>
          <label for="f-periodo">Competência</label>
          <select class="select" name="periodo" id="f-periodo" data-autosubmit <%= periods.length ? '' : 'disabled' %>>
            <% if (!periods.length) { %><option>—</option><% } %>
            <% periods.forEach(p => { %>
              <option value="<%= p %>" <%= filter.periodo === p ? 'selected' : '' %>><%= fmt.periodFull(p) %></option>
            <% }) %>
          </select>
        </div>
        <% if (currencyOptions.length) { %>
        <div>
          <label for="f-moeda">Moeda</label>
          <select class="select" name="moeda" id="f-moeda" data-autosubmit data-enhance="currency" title="Moeda dos relatórios gerados pelo FGI0 (BP, DRE e Capital Empregado)">
            <% /* grupos na ordem das opções: BRL (moeda da empresa) vem primeiro */
               const grupos = [['grupo', 'Moeda do grupo'], ['empresa', 'Moeda da empresa']];
               if (currencyOptions[0]?.type === 'empresa') grupos.reverse();
               grupos.forEach(([type, groupLabel]) => {
                 const opts = currencyOptions.filter(o => o.type === type);
                 if (!opts.length) return; %>
              <optgroup label="<%= groupLabel %>">
                <% opts.forEach(o => { %>
                  <option value="<%= o.value %>" data-symbol="<%= o.symbol %>" data-flag="<%= o.flag || '' %>" data-code="<%= o.currency %>" data-count="<%= o.count %>" data-group="<%= groupLabel %>" <%= filter.moeda === o.value ? 'selected' : '' %>><%= o.symbol %> · <%= o.currency %> (<%= o.count %> empresa<%= o.count > 1 ? 's' : '' %>)</option>
                <% }) %>
              </optgroup>
            <% }) %>
          </select>
        </div>
        <% } %>
        <noscript><button class="btn btn-primary" type="submit">Aplicar</button></noscript>
        <% if (hasObraFilter) { %>
          <div class="filters-clear"><a class="btn btn-ghost" href="?estrutura=&sigla=&empresa=&centro=">Limpar filtros</a></div>
        <% } %>
      </form>
        </div>
      </div>
      <% } %>
      <% const iniciais = (user.name || user.email).trim().split(/\s+/).map(p => p[0]).slice(0, 2).join('').toUpperCase();
         const perfil = user.role === 'admin' ? 'Administrador' : (user.todosCentros ? 'Consulta' : 'Consulta · ' + user.centros.length + ' centro(s)'); %>
      <div class="user-menu" id="user-menu">
        <button class="user-btn" type="button" id="user-btn" aria-haspopup="true" aria-expanded="false" aria-controls="user-panel" title="<%= user.name || user.email %> · <%= perfil %>">
          <span class="avatar"><%= iniciais %></span>
        </button>
        <div class="user-panel" id="user-panel" hidden>
          <div class="user-panel-head">
            <span class="avatar"><%= iniciais %></span>
            <div class="user-info"><strong><%= user.name || user.email %></strong><span><%= perfil %></span><% if (user.name && user.email) { %><span class="user-email"><%= user.email %></span><% } %></div>
          </div>
          <button class="theme-btn user-tema" type="button" id="theme-toggle" title="Mudar para o tema escuro" aria-label="Mudar para o tema escuro" aria-pressed="false">
            <svg class="tema-svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <g class="tema-sol"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/></g>
          <path class="tema-lua" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
          <g class="tema-estrelas"><path d="M17.5 3.5v2M16.5 4.5h2"/><path d="M20.5 8v1.4M19.8 8.7h1.4"/></g>
        </svg>
            <span class="tema-texto">Tema escuro</span>
          </button>
          <form method="post" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="user-sair" type="submit"><%- include('icon', { name: 'logout' }) %>Sair do sistema</button>
          </form>
        </div>
      </div>
    </header>
    <main class="content">
