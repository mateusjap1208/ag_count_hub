<%# Capital Empregado · visão de obra (services/temasBalanco.js): posição de liquidação e obrigações da obra. Preenchido por public/js/app.js. %>
<% const tb = locals.tb; const cur = locals.cur || 'BRL'; %>
<% if (tb.liquidacao) { %>
<div class="card bloco-largo tb-encerrar" data-ordem-chave="ce-encerrar" id="tb-encerrar">
  <div class="card-head dp-head">
    <div>
      <h2>Posição de liquidação da obra</h2>
      <span class="hint">Obrigações exigíveis × recursos realizáveis na data-base de <%= tb.rotulo %>, com premissas de realização ajustáveis · valores em <%= cur %></span>
    </div>
    <div class="dp-controles"><button type="button" class="btn btn-ghost" data-enc-zerar>Restaurar premissas</button></div>
  </div>
  <div class="tb-enc-grid">
    <div class="tb-enc-ajustes" data-enc-ajustes></div>
    <div class="tb-enc-resultado" data-enc-resultado aria-live="polite"></div>
  </div>
  <p class="note dp-nota">Estimativa com base nos saldos contábeis da data-base. Não contempla custos de desmobilização, penalidades contratuais ou verbas rescisórias não provisionadas (simule-as em custos adicionais de desmobilização).<% if (tb.liquidacao.semCaixa) { %> Sem o Balanço desta seleção, o caixa ficou de fora.<% } %></p>
</div>
<% } %>

<div class="card bloco-largo tb-deve" data-ordem-chave="ce-deve" id="tb-deve">
  <div class="card-head dp-head">
    <div>
      <h2>Obrigações da obra</h2>
      <span class="hint">Pessoal, fornecedores e tributos em <%= tb.rotulo %><%= tb.rotuloAnterior ? `, com a variação contra ${tb.rotuloAnterior}` : '' %> · clique num item para ver as contas</span>
    </div>
  </div>
  <div class="tb-deve-grid" data-deve></div>
</div>
