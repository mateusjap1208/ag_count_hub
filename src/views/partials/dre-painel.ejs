<%# Painel do resultado da DRE (services/painelDre.js). Os cards são preenchidos e ligados entre si por public/js/app.js. %>
<% const dp = locals.dp; const cur = locals.cur || 'BRL'; const ano = dp.periodo.slice(0, 4); %>
<div class="card bloco-largo dp-resultado" data-ordem-chave="dre-resultado" id="dp-resultado">
  <div class="card-head dp-head">
    <div>
      <h2>Resultado <span data-dp-titulo></span></h2>
      <span class="hint">Clique em Receita, Custos ou Despesas para ver a composição · valores em <%= cur %></span>
    </div>
    <div class="dp-controles">
      <div class="dp-seg" role="group" aria-label="Período dos valores">
        <button type="button" class="dp-seg-btn" data-dp-modo="mes" aria-pressed="false">Mês</button>
        <button type="button" class="dp-seg-btn" data-dp-modo="ano" aria-pressed="false">Acumulado no ano</button>
      </div>
      <label class="sr-only" for="dp-mes">Mês exibido</label>
      <select class="select dp-mes" id="dp-mes" data-dp-mes>
        <% dp.meses.filter(m => m.carregado).slice().reverse().forEach(m => { %>
          <option value="<%= m.periodo %>" <%= m.periodo === dp.periodo ? 'selected' : '' %>><%= m.rotulo %></option>
        <% }) %>
      </select>
    </div>
  </div>
  <div class="dp-tiles" data-dp-tiles role="group" aria-label="Partes do resultado"></div>
  <p class="dp-aviso" data-dp-aviso hidden></p>
</div>

<div class="card dp-composicao" data-ordem-chave="dre-composicao">
  <div class="card-head dp-head">
    <div>
      <h2>Composição <span data-dp-comp-titulo></span></h2>
      <span class="hint" data-dp-comp-total></span>
    </div>
  </div>
  <div class="dp-partes" data-dp-partes role="group" aria-label="Parte do resultado"></div>
  <ol class="dp-barras" data-dp-barras aria-live="polite"></ol>
</div>

<div class="card dp-evolucao" data-ordem-chave="dre-evolucao">
  <div class="card-head">
    <h2>Evolução mensal · <%= ano %></h2>
    <span class="hint">Clique num mês para ver o resultado dele</span>
  </div>
  <div class="chart-box"><canvas id="chart-dre-evolucao" aria-label="Receita líquida, custos e lucro líquido mês a mês"></canvas></div>
  <% if (dp.faltando.length) { %>
    <p class="note dp-nota">Sem FGI0 de <%= dp.faltando.length > 3 ? `${dp.faltando[0]} a ${dp.faltando[dp.faltando.length - 1]}` : dp.faltando.join(', ') %>: esses meses ficam em branco. O valor de um mês só aparece quando o FGI0 do mês anterior também está carregado.</p>
  <% } %>
</div>

<%# Cards criados depois: ponte, Pareto, busca e simulador %>
<% const carregados = dp.meses.filter(m => m.carregado).slice().reverse(); %>
<div class="card bloco-largo dp-ponte" data-ordem-chave="dre-ponte" id="dp-ponte">
  <div class="card-head dp-head">
    <div>
      <h2>Ponte do lucro</h2>
      <span class="hint">O que explica a diferença de lucro entre dois períodos · clique num degrau para ver a composição</span>
    </div>
    <div class="dp-controles">
      <div class="dp-seg" role="group" aria-label="Período da ponte">
        <button type="button" class="dp-seg-btn" data-ponte-modo="mes" aria-pressed="false">Mês</button>
        <button type="button" class="dp-seg-btn" data-ponte-modo="ano" aria-pressed="false">Acumulado</button>
      </div>
      <label class="dp-campo">De <select class="select" data-ponte-de><% carregados.forEach(m => { %><option value="<%= m.periodo %>"><%= m.rotulo %></option><% }) %></select></label>
      <label class="dp-campo">Para <select class="select" data-ponte-para><% carregados.forEach(m => { %><option value="<%= m.periodo %>"><%= m.rotulo %></option><% }) %></select></label>
    </div>
  </div>
  <p class="dp-aviso" data-ponte-aviso hidden></p>
  <div class="chart-box"><canvas id="chart-dre-ponte" aria-label="Ponte do lucro entre dois períodos"></canvas></div>
</div>

<div class="card dp-pareto" data-ordem-chave="dre-pareto" id="dp-pareto">
  <div class="card-head dp-head">
    <div>
      <h2>Pareto <span data-pareto-titulo></span></h2>
      <span class="hint" data-pareto-resumo></span>
    </div>
  </div>
  <div class="dp-partes" data-pareto-partes role="group" aria-label="Parte do resultado"></div>
  <div class="dp-corte">
    <label for="dp-corte">Corte</label>
    <input type="range" id="dp-corte" min="50" max="95" step="5" value="80" data-pareto-corte>
    <output for="dp-corte" data-pareto-corte-valor>80%</output>
  </div>
  <div class="chart-box tall"><canvas id="chart-dre-pareto" aria-label="Contas da maior para a menor, com o percentual acumulado"></canvas></div>
  <p class="note dp-nota" data-pareto-nota hidden></p>
</div>

<div class="card dp-busca" data-ordem-chave="dre-busca" id="dp-busca">
  <div class="card-head dp-head">
    <div>
      <h2>Buscar conta</h2>
      <span class="hint">Número ou descrição da conta · valores de jan até <%= dp.meses[dp.meses.length - 1].rotulo %></span>
    </div>
  </div>
  <input class="input" type="search" placeholder="Ex.: 5321600000, salário, aluguel…" autocomplete="off" aria-label="Buscar conta contábil" data-busca-campo>
  <ul class="dp-busca-lista" data-busca-lista aria-live="polite"></ul>
  <div class="dp-busca-detalhe" data-busca-detalhe hidden>
    <div class="dp-busca-cab">
      <strong data-busca-nome></strong>
      <span class="hint" data-busca-grupo></span>
    </div>
    <div class="dp-busca-nums" data-busca-nums></div>
    <div class="chart-box dp-busca-graf"><canvas id="chart-dre-conta" aria-label="Valor da conta mês a mês"></canvas></div>
  </div>
</div>

<div class="card bloco-largo dp-simulador" data-ordem-chave="dre-simulador" id="dp-simulador">
  <div class="card-head dp-head">
    <div>
      <h2>Simulador "e se"</h2>
      <span class="hint">Mexa nas alavancas e veja o efeito no lucro · nada é gravado</span>
    </div>
    <div class="dp-controles">
      <label class="dp-campo">Base
        <select class="select" data-sim-base>
          <option value="mes">Mês da competência</option>
          <option value="media3">Média dos últimos 3 meses</option>
          <option value="ano">Acumulado no ano</option>
        </select>
      </label>
      <button type="button" class="btn btn-ghost" data-sim-zerar>Zerar</button>
    </div>
  </div>
  <p class="dp-aviso" data-sim-aviso hidden></p>
  <div class="dp-sim-grid">
    <div class="dp-sim-alavancas" data-sim-alavancas></div>
    <div class="dp-sim-resultado" data-sim-resultado aria-live="polite"></div>
  </div>
</div>
