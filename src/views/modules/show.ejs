<%- include('../partials/layout-start') %>

<% if (view.def.tabs) { %>
  <nav class="module-tabs" aria-label="<%= view.def.menu %>">
    <% view.def.tabs.forEach(t => { %>
      <a class="module-tab <%= t.slug === slug ? 'active' : '' %>" href="/modulos/<%= t.slug %>" <%- t.slug === slug ? 'aria-current="page"' : '' %>><%= t.label %></a>
    <% }) %>
  </nav>
<% } %>

<% const rc = locals.rowCurrencies || []; %>
<% if (view.def.source === 'arrendamento' || rc.length > 1) { %>
  <div class="module-toolbar">
    <% if (rc.length > 1) { %>
      <div class="chips-row" role="group" aria-label="Moeda">
        <span class="note"><%= view.def.source === 'arrendamento' ? 'Moeda do contrato:' : 'Moeda:' %></span>
        <% rc.forEach(c => { %>
          <a class="chip chip-cur <%= filter.moedaContrato === c.code ? 'active' : '' %>" href="?moedaContrato=<%= c.code %>">
            <% if (c.flag) { %><img src="<%= c.flag %>" alt=""><% } %><%= c.code %> <span class="chip-count"><%= c.symbol %></span>
          </a>
        <% }) %>
      </div>
    <% } else { %><span></span><% } %>
    <% if (user.role === 'admin' && view.def.source === 'arrendamento') { %>
      <a class="btn btn-primary" href="/arrendamento/importar"><%- include('../partials/icon', { name: 'upload' }) %>Importar arrendamento</a>
    <% } %>
  </div>
<% } %>

<% const excelLabel = (view.def.rowFilters || []).some(f => f.param === 'giro') ? 'Baixar Excel (Status Giro)' : 'Baixar Excel'; %>
<% if ((view.def.rowFilters || []).length) { %>
  <div class="module-toolbar">
    <% view.def.rowFilters.forEach(rf => { const atual = (filter.rowFilters || {})[rf.param] || ''; %>
      <div class="chips-row" role="group" aria-label="<%= rf.label %>">
        <span class="note"><%= rf.label %>:</span>
        <a class="chip <%= atual ? '' : 'active' %>" href="?<%= rf.param %>=">Todos</a>
        <% rf.options.forEach(o => { %>
          <a class="chip chip-giro <%= atual === o ? 'active' : '' %>" data-giro="<%= o %>" href="?<%= rf.param %>=<%= encodeURIComponent(o) %>"><span class="giro-dot" aria-hidden="true"></span><%= o %></a>
        <% }) %>
      </div>
    <% }) %>
    <a class="btn btn-primary" href="/modulos/<%= slug %>/exportar.xlsx"><%- include('../partials/icon', { name: 'download' }) %><%= excelLabel %></a>
  </div>
<% } %>

<% if (view.empty) { %>
  <%- include('../partials/empty', view.def.source === 'fgi0'
    ? { heading: 'Sem FGI0 para este filtro', text: 'Suba o relatório FGI0 (saldos contábeis) da competência e moeda desejadas para gerar este relatório.' }
    : view.def.source === 'estoque'
      ? { heading: 'Sem estoque para este filtro', text: 'Suba o relatório ZL0190 (estoque) da competência em Upload de relatórios. O nome do arquivo deve ter a competência, ex.: "ZL0190 - ESTOQUE_10.2026.xlsx".' }
    : view.def.importer
      ? { heading: 'Sem dados para este filtro', text: 'Suba o relatório ' + view.def.importer.label + ' da competência em Upload de relatórios (o nome do arquivo deve ter a competência, ex.: _10.2026).' }
    : view.def.source === 'arrendamento'
      ? { heading: 'Sem arrendamento para este filtro', text: 'Importe o cronograma de arrendamento (IFRS 16) da competência selecionada.' }
      : {}) %>
<% } else { %>
  <% const cur = currency || 'BRL'; %>
  <%- include('../partials/kpis', { kpis: view.kpis, currency: cur }) %>

  <% if (view.tree) {
       const periodos = view.periodos || [filter.periodo];
       const comparando = periodos.length > 1;
       // Data de encerramento de cada competência (padrão das demonstrações: 31/10/2026, 31/12/2025…)
       const dataFim = (p) => { const [y, m] = p.split('-').map(Number); return new Date(Date.UTC(y, m, 0)).toISOString().slice(0, 10).split('-').reverse().join('/'); };
       const cel = (v) => v == null ? '—' : fmt.currency(v, cur);
       const variacao = (l) => (l.values[0] == null || l.values[1] == null) ? null : l.values[0] - l.values[1];
       const pct = (l) => { const d = variacao(l); return d == null || !l.values[1] ? '—' : ((d / Math.abs(l.values[1])) * 100).toFixed(1).replace('.', ',') + '%'; };
       const comp = locals.comparacao || { disponiveis: [], escolhidas: [], max: 3 }; %>
    <div class="card mt">
      <div class="card-head">
        <h2><%= view.def.title %><%= comparando ? ' comparativo' : '' %></h2>
        <div class="table-tools">
          <span class="hint">Valores em <%= cur %></span>
          <details class="compare-picker">
            <summary class="btn btn-ghost"><%- include('../partials/icon', { name: 'layers' }) %>Comparar<% if (comp.escolhidas.length) { %><span class="filters-badge"><%= comp.escolhidas.length %></span><% } %></summary>
            <form method="get" class="compare-panel">
              <p class="compare-title">Comparar <%= fmt.periodFull(filter.periodo) %> com:</p>
              <input type="hidden" name="comparar" value="">
              <% if (!comp.disponiveis.length) { %>
                <p class="hint">Nenhuma outra competência carregada. Suba o FGI0 de outros meses para montar o comparativo.</p>
              <% } else { comp.disponiveis.forEach(p => { %>
                <label class="compare-opt"><input type="checkbox" name="comparar" value="<%= p %>" <%= comp.escolhidas.includes(p) ? 'checked' : '' %>> <%= fmt.periodFull(p) %> <span class="hint"><%= dataFim(p) %></span></label>
              <% }) %>
                <p class="hint">Até <%= comp.max %> competências. A mais recente aparece primeiro.</p>
                <div class="compare-actions">
                  <button class="btn btn-primary" type="submit">Aplicar</button>
                  <% if (comp.escolhidas.length) { %><a class="btn btn-ghost" href="?comparar=">Limpar</a><% } %>
                </div>
              <% } %>
            </form>
          </details>
          <% if (view.tree.some(l => l.kind === 'group')) { %><button class="btn btn-ghost" type="button" data-tree-toggle>Recolher tudo</button><% } %>
        </div>
      </div>
      <div class="table-wrap">
        <table class="statement tree <%= comparando ? 'compare' : '' %>" id="tree-table">
          <% if (comparando) { %>
          <thead>
            <tr>
              <th></th>
              <% periodos.forEach((p, i) => { %><th class="num"><%= dataFim(p) %><% if (i === 0) { %><span class="th-sub">atual</span><% } %></th><% }) %>
              <th class="num">Variação<span class="th-sub">vs <%= dataFim(periodos[1]) %></span></th>
              <th class="num">%</th>
            </tr>
          </thead>
          <% } %>
          <tbody>
            <% // As contas de cada linha vão para o popup do olho (não viram linhas da tabela)
               const linhas = [];
               view.tree.forEach(l => { if (l.kind === 'conta') linhas[linhas.length - 1].lista.push(l); else linhas.push({ ...l, lista: [] }); });
               let gi = 0;
               linhas.forEach(l => {
                 if (l.kind === 'group') gi++;
                 const attrs = l.kind === 'group' ? `data-group="${gi}" tabindex="0" role="button" aria-expanded="true"` : l.kind === 'item' ? `data-parent="${gi}"` : ''; %>
              <tr class="t-<%= l.kind %> <%= l.highlight ? 'highlight' : '' %>" <%- attrs %>>
                <td><% if (l.kind === 'group') { %><span class="caret">▾</span><% } %><%= l.label %></td>
                <% if (l.kind === 'section') { %>
                  <td colspan="<%= comparando ? periodos.length + 2 : 1 %>"></td>
                <% } else { %>
                  <% (comparando ? l.values : [l.value]).forEach((v, ci) => { %><td class="num <%= v < 0 ? 'neg' : '' %>"><% if (ci === 0 && l.lista.length) { %><button class="eye-btn" type="button" aria-label="Ver as <%= l.lista.length %> contas contábeis de <%= l.label %>" data-eye><svg class="eye" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path class="eye-lid-closed" d="M3 12c2.5 3 5.5 4.5 9 4.5s6.5-1.5 9-4.5M6 15.2l-1.4 1.9M12 16.5v2.3M18 15.2l1.4 1.9"/><g class="eye-open"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle class="eye-pupil" cx="12" cy="12" r="3"/></g></svg></button><template class="eye-data">
                    <div class="pop-head"><strong><%= l.label %></strong><span><%= l.lista.length %> conta<%= l.lista.length > 1 ? 's' : '' %> contábe<%= l.lista.length > 1 ? 'is' : 'l' %></span></div>
                    <div class="pop-scroll"><table class="pop-table">
                      <% if (comparando) { %><thead><tr><th>Conta</th><% periodos.forEach(p => { %><th class="num"><%= dataFim(p) %></th><% }) %></tr></thead><% } %>
                      <tbody>
                        <% l.lista.forEach(c => { const sep = c.label.indexOf(' - '); %>
                          <tr><td><span class="pop-cod"><%= sep > 0 ? c.label.slice(0, sep) : c.label %></span><%= sep > 0 ? c.label.slice(sep + 3) : '' %></td><% (comparando ? c.values : [c.value]).forEach(cv => { %><td class="num <%= cv < 0 ? 'neg' : '' %>"><%= cel(cv) %></td><% }) %></tr>
                        <% }) %>
                      </tbody>
                      <tfoot><tr><td>Total</td><% (comparando ? l.values : [l.value]).forEach(tv => { %><td class="num"><%= cel(tv) %></td><% }) %></tr></tfoot>
                    </table></div>
                  </template><% } %><%= cel(v) %></td><% }) %>
                  <% if (comparando) { const d = variacao(l); %>
                    <td class="num var <%= d == null ? '' : d < 0 ? 'neg' : 'pos' %>"><%= d == null ? '—' : fmt.currency(d, cur) %></td>
                    <td class="num var"><%= pct(l) %></td>
                  <% } %>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <% const charts = view.charts; %>
  <div class="grid <%= charts.length === 1 && !view.statement ? '' : 'grid-2' %> mt">
    <% if (view.statement) { %>
      <div class="card">
        <div class="card-head"><h2><%= view.def.source === 'arrendamento' ? 'Movimentação do mês' : view.def.slug === 'imobilizado' ? 'Movimentação do ano' : 'Demonstração estruturada' %></h2><span class="hint">Valores em <%= cur %></span></div>
        <div class="table-wrap">
          <table class="statement">
            <tbody>
              <% view.statement.forEach(l => { %>
                <% if (l.kind === 'section') { %>
                  <tr class="section-row"><td colspan="2"><%= l.label %></td></tr>
                <% } else { %>
                <tr class="<%= l.subtotal ? 'subtotal' : '' %> <%= l.highlight ? 'highlight' : '' %>">
                  <td><%= l.label %></td>
                  <td class="num <%= l.value < 0 ? 'neg' : '' %>"><%= fmt.currency(l.value, cur) %></td>
                </tr>
                <% } %>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
    <% charts.forEach((c, i) => { %>
      <div class="card <%= (charts.length === 3 && i === 0 && !view.statement) || (view.statement && charts.length === 3 && i === 2) ? 'span-2' : '' %>">
        <div class="card-head"><h2><%= c.label %></h2></div>
        <div class="chart-box <%= c.type === 'hbar' ? 'tall' : '' %>"><canvas id="chart-<%= c.id %>" aria-label="<%= c.label %>"></canvas></div>
      </div>
    <% }) %>
  </div>

  <div class="card mt" id="data-table" data-endpoint="/api/modulos/<%= slug %>/linhas" data-currency="<%= cur %>" data-columns="<%= JSON.stringify(columns) %>">
    <div class="card-head">
      <h2>Detalhamento <span class="hint">(<%= fmt.number(view.count) %> linhas<%= showCurrency ? ' · ' + cur : '' %>)</span></h2>
      <div class="table-tools">
        <label class="sr-only" for="table-search">Buscar</label>
        <input class="input" type="search" id="table-search" placeholder="Buscar em todas as colunas…" autocomplete="off">
        <a class="btn btn-ghost" href="/modulos/<%= slug %>/exportar.csv"><%- include('../partials/icon', { name: 'download' }) %>CSV</a>
        <a class="btn btn-ghost" href="/modulos/<%= slug %>/exportar.xlsx"><%- include('../partials/icon', { name: 'download' }) %><%= excelLabel %></a>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <% columns.forEach(c => { %>
            <th data-sort="<%= c.key %>" class="<%= c.type === 'number' ? 'num' : '' %>"><%= c.label %><span class="arrow"></span></th>
          <% }) %>
        </tr></thead>
        <tbody><tr><td colspan="<%= columns.length %>">Carregando…</td></tr></tbody>
      </table>
    </div>
    <div class="pager">
      <span class="info"></span>
      <div class="btns">
        <button class="btn btn-ghost" type="button" data-page="prev">Anterior</button>
        <button class="btn btn-ghost" type="button" data-page="next">Próxima</button>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/layout-end') %>
