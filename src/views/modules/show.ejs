<%- include('../partials/layout-start') %>

<% if (view.def.tabs) { %>
  <nav class="module-tabs" aria-label="<%= view.def.menu %>">
    <% view.def.tabs.forEach(t => { %>
      <a class="module-tab <%= t.slug === slug ? 'active' : '' %>" href="/modulos/<%= t.slug %>" <%- t.slug === slug ? 'aria-current="page"' : '' %>><%= t.label %></a>
    <% }) %>
  </nav>
<% } %>

<% const rc = locals.rowCurrencies || []; %>
<% if (view.def.source === 'arrendamento' || rc.length > 1) { %>
  <div class="module-toolbar">
    <% if (rc.length > 1) { %>
      <div class="chips-row" role="group" aria-label="Moeda">
        <span class="note"><%= view.def.source === 'arrendamento' ? 'Moeda do contrato:' : 'Moeda:' %></span>
        <% rc.forEach(c => { %>
          <a class="chip chip-cur <%= filter.moedaContrato === c.code ? 'active' : '' %>" href="?moedaContrato=<%= c.code %>">
            <% if (c.flag) { %><img src="<%= c.flag %>" alt=""><% } %><%= c.code %> <span class="chip-count"><%= c.symbol %></span>
          </a>
        <% }) %>
      </div>
    <% } else { %><span></span><% } %>
    <% if (user.role === 'admin' && view.def.source === 'arrendamento') { %>
      <a class="btn btn-primary" href="/arrendamento/importar"><%- include('../partials/icon', { name: 'upload' }) %>Importar arrendamento</a>
    <% } %>
  </div>
<% } %>

<% if ((view.def.rowFilters || []).length) { %>
  <div class="module-toolbar">
    <% view.def.rowFilters.forEach(rf => { const atual = (filter.rowFilters || {})[rf.param] || ''; %>
      <div class="chips-row" role="group" aria-label="<%= rf.label %>">
        <span class="note"><%= rf.label %>:</span>
        <a class="chip <%= atual ? '' : 'active' %>" href="?<%= rf.param %>=">Todos</a>
        <% rf.options.forEach(o => { %>
          <a class="chip chip-giro <%= atual === o ? 'active' : '' %>" data-giro="<%= o %>" href="?<%= rf.param %>=<%= encodeURIComponent(o) %>"><span class="giro-dot" aria-hidden="true"></span><%= o %></a>
        <% }) %>
      </div>
    <% }) %>
    <a class="btn btn-ghost" href="/relatorios"><%- include('../partials/icon', { name: 'download' }) %>Extrair em Relatórios</a>
  </div>
<% } %>

<% if (view.empty) { %>
  <%- include('../partials/empty', view.def.source === 'fgi0'
    ? { heading: 'Sem FGI0 para este filtro', text: 'Suba o relatório FGI0 (saldos contábeis) da competência e moeda desejadas para gerar este relatório.' }
    : view.def.source === 'estoque'
      ? { heading: 'Sem estoque para este filtro', text: 'Suba o relatório ZL0190 (estoque) da competência em Upload de relatórios. O nome do arquivo deve ter a competência, ex.: "ZL0190 - ESTOQUE_10.2026.xlsx".' }
    : view.def.importer
      ? { heading: 'Sem dados para este filtro', text: 'Suba o relatório ' + view.def.importer.label + ' da competência em Upload de relatórios (o nome do arquivo deve ter a competência, ex.: _10.2026).' }
    : view.def.source === 'arrendamento'
      ? { heading: 'Sem arrendamento para este filtro', text: 'Importe o cronograma de arrendamento (IFRS 16) da competência selecionada.' }
      : {}) %>
<% } else { %>
  <% const cur = currency || 'BRL'; %>
  <%- include('../partials/kpis', { kpis: view.kpis, currency: cur }) %>

  <%# Todos os quadros e gráficos da tela num grupo só: o usuário pode reordenar qualquer um %>
  <div class="grid grid-2 mt blocos" data-ordenavel="blocos" aria-label="Quadros e gráficos">

  <% if (view.painelDre) { %><%- include('../partials/dre-painel', { dp: view.painelDre, cur }) %><% } %>
  <% if (view.painelPatrimonial) { %><%- include('../partials/patrimonial-painel', { pp: view.painelPatrimonial, cur }) %><% } %>
  <% if (view.gauges && view.gauges.length) { %><%- include('../partials/velocimetros', { gauges: view.gauges, cur, fmt }) %><% } %>
  <% if (view.maioresFornecedores) { %><%- include('../partials/maiores-fornecedores', { mf: view.maioresFornecedores, fmt }) %><% } %>
  <% if (view.pedidosRecepcao) { const pr = view.pedidosRecepcao; %>
    <div class="card pedidos-recepcao bloco-largo" data-ordem-chave="pedidos-recepcao">
      <div class="card-head">
        <h2>Conta <%= pr.conta %> · Recepção & Conferência por pedido de compra</h2>
        <span class="hint">FAGLL03 de fornecedores + EKKO · valores em <%= cur %></span>
      </div>
      <% if (pr.vazio) { %>
        <p class="hint">Sem lançamentos da conta <%= pr.conta %> nesta seleção.</p>
      <% } else { %>
        <p class="conta-arr-resumo">Saldo da conta: <strong class="<%= pr.saldo < 0 ? 'neg' : '' %>"><%= fmt.currency(pr.saldo, cur) %></strong> · <%= fmt.number(pr.lancamentos) %> lançamentos · <%= fmt.number(pr.pedidos.length) %> pedidos com saldo (<%= fmt.number(pr.pedidosZerados) %> zerados não aparecem)<% if (pr.doEkko) { %> · <strong><%= fmt.number(pr.doEkko) %></strong> fornecedores identificados pelo EKKO<% } %></p>
        <% if (!pr.temEkko) { %>
          <div class="alert alert-warn">O EKKO (pedidos de compra por fornecedor) ainda não foi carregado em Parâmetros. Sem ele, os pedidos sem fornecedor no lançamento ficam em branco.</div>
        <% } %>
        <div class="tl-picker"><input class="input" type="search" placeholder="Buscar pedido ou fornecedor" data-filtro-tabela="#tab-pedidos" aria-label="Buscar pedido ou fornecedor"></div>
        <div class="table-wrap conta-arr-wrap">
          <table id="tab-pedidos">
            <thead><tr><th>Pedido de compra</th><th>Fornecedor</th><th>Data do lançamento</th><th class="num">Lançamentos</th><th class="num">Montante</th></tr></thead>
            <tbody>
              <% pr.pedidos.forEach(p => { %>
                <tr>
                  <td><%= p.pedido || '(sem pedido)' %></td>
                  <td><%= p.fornecedorNome || '—' %><% if (p.origem === 'EKKO') { %> <span class="tag-ekko" title="Fornecedor identificado pelo pedido no EKKO">EKKO</span><% } %></td>
                  <td><%= p.data ? p.data.split('-').reverse().join('/') : '—' %></td>
                  <td class="num"><%= fmt.number(p.lancamentos) %></td>
                  <td class="num <%= p.montante < 0 ? 'neg' : '' %>"><%= fmt.currency(p.montante, cur) %></td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot><tr><td colspan="4">Total dos pedidos com saldo</td><td class="num"><%= fmt.currency(pr.pedidos.reduce((a, p) => a + p.montante, 0), cur) %></td></tr></tfoot>
          </table>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (view.imobMapeamento) { const im = view.imobMapeamento; %>
    <div class="card bloco-largo imob-mapa" data-ordem-chave="classificacao-mapeamento">
      <div class="card-head">
        <h2>Classificação pelo Mapeamento de Contas</h2>
        <span class="hint">Grupo do Capital Empregado › Descrição Conta Contábil · valores em <%= cur %></span>
      </div>
      <div class="table-wrap">
        <table class="statement">
          <thead><tr><th>Classificação</th><th class="num">Bens</th><th class="num">Custo (CAP)</th><th class="num">Depreciação acumulada</th><th class="num">Valor contábil</th><th class="num">% do valor contábil</th></tr></thead>
          <tbody>
            <% im.grupos.forEach(g => { %>
              <tr class="subtotal"><td><%= g.grupo %></td><td class="num"><%= fmt.number(g.total.bens) %></td><td class="num"><%= fmt.currency(g.total.custo, cur) %></td><td class="num <%= g.total.dep < 0 ? 'neg' : '' %>"><%= fmt.currency(g.total.dep, cur) %></td><td class="num"><%= fmt.currency(g.total.vc, cur) %></td><td class="num"><%= im.total.vc ? (g.total.vc / im.total.vc * 100).toFixed(1).replace('.', ',') + '%' : '—' %></td></tr>
              <% g.contas.forEach(c => { %>
                <tr class="imob-conta"><td><%= c.conta %></td><td class="num"><%= fmt.number(c.bens) %></td><td class="num"><%= fmt.currency(c.custo, cur) %></td><td class="num <%= c.dep < 0 ? 'neg' : '' %>"><%= fmt.currency(c.dep, cur) %></td><td class="num"><%= fmt.currency(c.vc, cur) %></td><td class="num"><%= im.total.vc ? (c.vc / im.total.vc * 100).toFixed(1).replace('.', ',') + '%' : '—' %></td></tr>
              <% }) %>
            <% }) %>
            <tr class="highlight"><td>Total do imobilizado</td><td class="num"><%= fmt.number(im.total.bens) %></td><td class="num"><%= fmt.currency(im.total.custo, cur) %></td><td class="num"><%= fmt.currency(im.total.dep, cur) %></td><td class="num"><%= fmt.currency(im.total.vc, cur) %></td><td class="num">100,0%</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <% if (view.contaArrendamento) { const ca = view.contaArrendamento; %>
    <div class="card bloco-largo" data-ordem-chave="conta-arrendamento">
      <div class="card-head">
        <h2>Conta <%= ca.conta %> · Medições × parcelas de arrendamento</h2>
        <span class="hint">FAGLL03 de fornecedores · valores em <%= ca.moeda %></span>
      </div>
      <% if (ca.vazio) { %>
        <p class="hint">Sem lançamentos da conta <%= ca.conta %> nesta competência. Suba o FAGLL03 de fornecedores do mês.</p>
      <% } else { %>
        <p class="conta-arr-resumo">Saldo da conta: <strong class="<%= ca.saldo < 0 ? 'neg' : '' %>"><%= fmt.currency(ca.saldo, ca.moeda) %></strong> · <%= fmt.number(ca.lancamentos) %> lançamentos<% if (ca.temAtribuicao) { %> · <%= fmt.number(ca.abertas.length) %> atribuições com saldo (<%= fmt.number(ca.zeradas) %> zeradas não aparecem)<% } %></p>
        <% if (!ca.temAtribuicao) { %>
          <div class="alert alert-warn">O arquivo FAGLL03 de fornecedores desta competência não tem a coluna <strong>Atribuição</strong>. Exporte o FAGLL03 com essa coluna e suba de novo para ver o detalhe por atribuição.</div>
        <% } else { %>
          <div class="table-wrap conta-arr-wrap">
            <table class="table">
              <thead><tr><th>Atribuição</th><th class="num">Lançamentos</th><th class="num">Montante</th></tr></thead>
              <tbody>
                <% ca.abertas.forEach(o => { %>
                  <tr><td><%= o.atribuicao %></td><td class="num"><%= fmt.number(o.lancamentos) %></td><td class="num <%= o.montante < 0 ? 'neg' : '' %>"><%= fmt.currency(o.montante, ca.moeda) %></td></tr>
                <% }) %>
              </tbody>
              <tfoot><tr><td>Total das atribuições com saldo</td><td></td><td class="num"><%= fmt.currency(ca.abertas.reduce((a, o) => a + o.montante, 0), ca.moeda) %></td></tr></tfoot>
            </table>
          </div>
        <% } %>
      <% } %>
    </div>
  <% } %>

  <% if (view.tree) {
       const periodos = view.periodos || [filter.periodo];
       const comparando = periodos.length > 1;
       // Data de encerramento de cada competência (padrão das demonstrações: 31/10/2026, 31/12/2025…)
       const dataFim = (p) => { const [y, m] = p.split('-').map(Number); return new Date(Date.UTC(y, m, 0)).toISOString().slice(0, 10).split('-').reverse().join('/'); };
       const cel = (v) => v == null ? '—' : fmt.currency(v, cur);
       const variacao = (l) => (l.values[0] == null || l.values[1] == null) ? null : l.values[0] - l.values[1];
       const pct = (l) => { const d = variacao(l); return d == null || !l.values[1] ? '—' : ((d / Math.abs(l.values[1])) * 100).toFixed(1).replace('.', ',') + '%'; };
       const comp = locals.comparacao || { disponiveis: [], escolhidas: [], max: 3 }; %>
    <div class="card bloco-largo" data-ordem-chave="demonstracao">
      <div class="card-head">
        <h2><%= view.def.title %><%= comparando ? ' comparativo' : '' %></h2>
        <div class="table-tools">
          <span class="hint">Valores em <%= cur %></span>
          <details class="compare-picker">
            <summary class="btn btn-ghost"><%- include('../partials/icon', { name: 'layers' }) %>Comparar<% if (comp.escolhidas.length) { %><span class="filters-badge"><%= comp.escolhidas.length %></span><% } %></summary>
            <form method="get" class="compare-panel">
              <p class="compare-title">Comparar <%= fmt.periodFull(filter.periodo) %> com:</p>
              <input type="hidden" name="comparar" value="">
              <% if (!comp.disponiveis.length) { %>
                <p class="hint">Nenhuma outra competência carregada. Suba o FGI0 de outros meses para montar o comparativo.</p>
              <% } else { comp.disponiveis.forEach(p => { %>
                <label class="compare-opt"><input type="checkbox" name="comparar" value="<%= p %>" <%= comp.escolhidas.includes(p) ? 'checked' : '' %>> <%= fmt.periodFull(p) %> <span class="hint"><%= dataFim(p) %></span></label>
              <% }) %>
                <p class="hint">Até <%= comp.max %> competências. A mais recente aparece primeiro.</p>
                <div class="compare-actions">
                  <button class="btn btn-primary" type="submit">Aplicar</button>
                  <% if (comp.escolhidas.length) { %><a class="btn btn-ghost" href="?comparar=">Limpar</a><% } %>
                </div>
              <% } %>
            </form>
          </details>
          <% if (view.tree.some(l => l.kind === 'group')) { %><button class="btn btn-ghost" type="button" data-tree-toggle data-state="closed" aria-controls="tree-table">Expandir tudo</button><% } %>
        </div>
      </div>
      <div class="table-wrap">
        <table class="statement tree <%= comparando ? 'compare' : '' %>" id="tree-table">
          <% if (comparando) { %>
          <thead>
            <tr>
              <th></th>
              <% periodos.forEach((p, i) => { %><th class="num"><%= dataFim(p) %><% if (i === 0) { %><span class="th-sub">atual</span><% } %></th><% }) %>
              <th class="num">Variação<span class="th-sub">vs <%= dataFim(periodos[1]) %></span></th>
              <th class="num">%</th>
            </tr>
          </thead>
          <% } %>
          <tbody>
            <% // As contas de cada linha vão para o popup do olho (não viram linhas da tabela)
               const linhas = [];
               view.tree.forEach(l => { if (l.kind === 'conta') linhas[linhas.length - 1].lista.push(l); else linhas.push({ ...l, lista: [] }); });
               let gi = 0;
               let grupoLbl = '';
               const codigoDe = (txt) => { const i = String(txt).indexOf(' - '); return (i > 0 ? String(txt).slice(0, i) : String(txt)).replace(/[^0-9A-Za-z]/g, ''); };
               const pendente = (txt) => /a classificar|não classificad/i.test(txt || '');
               linhas.forEach(l => {
                 if (l.kind === 'group') { gi++; grupoLbl = l.label; }
                 // BP: dentro de "Ativo/Passivo/PL a classificar" cada linha já é a própria conta
                 const contaSolta = l.kind === 'item' && pendente(grupoLbl) && !l.lista.length;
                 const attrs = l.kind === 'group' ? `data-group="${gi}" tabindex="0" role="button" aria-expanded="false"` : l.kind === 'item' ? `data-parent="${gi}"` : ''; %>
              <tr class="t-<%= l.kind %> <%= l.highlight ? 'highlight' : '' %> <%= l.kind === 'group' ? 'collapsed' : '' %> <%= l.kind === 'item' && gi > 0 ? 'hidden' : '' %>" <%- attrs %>>
                <td><% if (l.kind === 'group') { %><span class="caret">▾</span><% } %><% if (contaSolta) { %><button class="link-classificar" type="button" data-classificar="<%= codigoDe(l.label) %>" title="Vincular esta conta no Plano de Contas"><%= l.label %></button><% } else { %><%= l.label %><% } %></td>
                <% if (l.kind === 'section') { %>
                  <td colspan="<%= comparando ? periodos.length + 2 : 1 %>"></td>
                <% } else { %>
                  <% (comparando ? l.values : [l.value]).forEach((v, ci) => { %><td class="num <%= v < 0 ? 'neg' : '' %>"><%= cel(v) %><% if (ci === 0 && l.lista.length) { %><button class="eye-btn" type="button" aria-label="Ver as <%= l.lista.length %> contas contábeis de <%= l.label %>" data-eye><svg class="eye" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path class="eye-lid-closed" d="M3 12c2.5 3 5.5 4.5 9 4.5s6.5-1.5 9-4.5M6 15.2l-1.4 1.9M12 16.5v2.3M18 15.2l1.4 1.9"/><g class="eye-open"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle class="eye-pupil" cx="12" cy="12" r="3"/></g></svg></button><template class="eye-data">
                    <div class="pop-head"><strong><%= l.label %></strong><span><%= l.lista.length %> conta<%= l.lista.length > 1 ? 's' : '' %> contábe<%= l.lista.length > 1 ? 'is' : 'l' %></span></div>
                    <div class="pop-scroll"><table class="pop-table">
                      <% if (comparando) { %><thead><tr><th>Conta</th><% periodos.forEach(p => { %><th class="num"><%= dataFim(p) %></th><% }) %></tr></thead><% } %>
                      <tbody>
                        <% l.lista.forEach(c => { const sep = c.label.indexOf(' - '); %>
                          <tr<%- pendente(l.label) ? ` data-classificar="${codigoDe(c.label)}" title="Clique para vincular esta conta" class="pop-vincular"` : '' %>><td><span class="pop-cod"><%= sep > 0 ? c.label.slice(0, sep) : c.label %></span><%= sep > 0 ? c.label.slice(sep + 3) : '' %></td><% (comparando ? c.values : [c.value]).forEach(cv => { %><td class="num <%= cv < 0 ? 'neg' : '' %>"><%= cel(cv) %></td><% }) %></tr>
                        <% }) %>
                      </tbody>
                      <tfoot><tr><td>Total</td><% (comparando ? l.values : [l.value]).forEach(tv => { %><td class="num"><%= cel(tv) %></td><% }) %></tr></tfoot>
                    </table></div>
                  </template><% } %></td><% }) %>
                  <% if (comparando) { const d = variacao(l); %>
                    <td class="num var <%= d == null ? '' : d < 0 ? 'neg' : 'pos' %>"><%= d == null ? '—' : fmt.currency(d, cur) %></td>
                    <td class="num var"><%= pct(l) %></td>
                  <% } %>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <% const charts = view.fluxo ? view.charts.filter(c => c.id !== 'fluxo') : view.charts; %>
  <% if (view.fluxo) { const fx = view.fluxo; %>
    <div class="card bloco-largo fluxo-tl" data-ordem-chave="fluxo-timeline">
      <div class="card-head">
        <h2>Fluxo mensal de apropriação</h2>
        <span class="hint">Valores em <%= cur %> · de janeiro até 12 meses após a competência</span>
      </div>
      <div class="fluxo-totais">
        <div><span>Apropriado no ano</span><strong><%= fmt.currency(fx.ano, cur) %></strong></div>
        <div><span>A apropriar em até 12 meses</span><strong><%= fmt.currency(fx.cp, cur) %></strong></div>
        <div><span>A apropriar após 12 meses</span><strong><%= fmt.currency(fx.lp, cur) %></strong></div>
        <div class="destaque"><span>Saldo a apropriar</span><strong><%= fmt.currency(fx.saldo, cur) %></strong></div>
      </div>
      <div class="fluxo-legenda" aria-hidden="true"><span class="lg realizado">Realizado</span><span class="lg atual">Competência</span><span class="lg futuro">A apropriar</span></div>
      <div class="fluxo-trilha" tabindex="0" aria-label="Linha do tempo mês a mês (role para os lados)">
        <ol class="fluxo-meses">
          <% fx.meses.forEach(x => { %>
            <li class="fluxo-mes <%= x.fase %>" title="<%= x.nome %>: <%= fmt.currency(x.valor, cur) %>">
              <span class="fm-valor"><%= fmt.kpi(x.valor, 'currency', cur) %></span>
              <span class="fm-barra" data-h="<%= Math.round(Math.abs(x.valor) / fx.max * 100) %>"></span>
              <span class="fm-ponto"></span>
              <span class="fm-mes"><%= x.rotulo %><% if (x.fase === 'atual') { %><em>competência</em><% } %></span>
            </li>
          <% }) %>
        </ol>
      </div>
    </div>
  <% } %>
    <% if (view.statement && !view.fluxo) { %>
      <div class="card" data-ordem-chave="quadro">
        <div class="card-head"><h2><%= view.def.source === 'arrendamento' ? 'Movimentação do mês' : view.def.slug === 'imobilizado' ? 'Movimentação do ano' : 'Demonstração estruturada' %></h2><span class="hint">Valores em <%= cur %></span></div>
        <div class="table-wrap">
          <table class="statement">
            <tbody>
              <% view.statement.forEach(l => { %>
                <% if (l.kind === 'section') { %>
                  <tr class="section-row"><td colspan="2"><%= l.label %></td></tr>
                <% } else { %>
                <tr class="<%= l.subtotal ? 'subtotal' : '' %> <%= l.highlight ? 'highlight' : '' %>">
                  <td><%= l.label %></td>
                  <td class="num <%= l.value < 0 ? 'neg' : '' %>"><%= fmt.currency(l.value, cur) %></td>
                </tr>
                <% } %>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
    <% charts.forEach((c, i) => { %>
      <div class="card <%= (charts.length === 1 && !view.statement) || (charts.length === 3 && i === 0 && !view.statement) || (view.statement && charts.length === 3 && i === 2) ? 'span-2' : '' %>" data-ordem-chave="<%= c.id %>">
        <div class="card-head"><h2><%= c.label %></h2></div>
        <div class="chart-box <%= c.type === 'hbar' ? 'tall' : '' %>"><canvas id="chart-<%= c.id %>" aria-label="<%= c.label %>"></canvas></div>
      </div>
    <% }) %>

  <% if (view.contratosSeguro) { const cs = view.contratosSeguro; %>
    <div class="card timeline-seguro bloco-largo" data-ordem-chave="linha-do-tempo" id="timeline-seguro" data-moeda="<%= cur %>">
      <div class="card-head">
        <h2>Linha do tempo por contrato</h2>
        <span class="hint">Evolução mensal da apropriação do prêmio</span>
      </div>
      <% if (!cs.length) { %>
        <p class="hint">Nenhum contrato com saldo a apropriar ou apropriação no ano nesta seleção.</p>
      <% } else { %>
        <div class="tl-picker">
          <label for="tl-contrato">Contrato</label>
          <select class="select" id="tl-contrato">
            <% cs.forEach((c, i) => { %>
              <option value="<%= c.empresa %>|<%= c.contrato %>" <%= i === 0 ? 'selected' : '' %>><%= c.contrato %> · <%= c.denominacao %> · <%= c.empresa %> · a apropriar <%= fmt.currency(c.aApropriar, cur) %></option>
            <% }) %>
          </select>
          <span class="hint"><%= fmt.number(cs.length) %> contratos com saldo ou apropriação no ano, do maior saldo para o menor</span>
        </div>
        <div class="tl-body" aria-live="polite">
          <div class="tl-resumo" data-tl-resumo></div>
          <div class="tl-barra" data-tl-barra></div>
          <div class="chart-box"><canvas id="chart-tl" aria-label="Apropriação mensal do contrato"></canvas></div>
          <div class="table-wrap tl-tabela"><table><thead><tr><th>Mês</th><th class="num">Apropriado no mês</th><th class="num">Acumulado</th><th class="num">Saldo a apropriar</th><th class="num">% apropriado</th></tr></thead><tbody data-tl-linhas></tbody></table></div>
        </div>
      <% } %>
    </div>
  <% } %>

  <%# Detalhamento (tabela analítica) e exportações: concentrados na tela Relatórios %>
  </div><%# fim dos quadros reordenáveis %>
<% } %>

<%- include('../partials/layout-end') %>
