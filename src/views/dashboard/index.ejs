<%- include('../partials/layout-start') %>

<% if (!periods.length) { %>
  <%- include('../partials/empty', { heading: 'Nenhum relatório carregado ainda', text: 'Suba os arquivos .txt exportados do SAP para começar a visualizar os dados.' }) %>
<% } else { %>

  <% if (highlights.length) { %>
  <div class="grid grid-4" data-ordenavel="kpis" aria-label="Indicadores">
    <% highlights.forEach(k => { %>
      <a class="card kpi <%= k.tone || '' %>" href="/modulos/<%= k.module %>" data-ordem-chave="<%= k.label %>">
        <div class="label"><%= k.label %></div>
        <div class="value" title="<%= fmt.value(k.value, k.format, k.currency) %>"><%= fmt.kpi(k.value, k.format, k.currency) %></div>
        <div class="meta"><%= fmt.value(k.value, k.format, k.currency) %><%= k.hint ? ' · ' + k.hint : '' %></div>
      </a>
    <% }) %>
  </div>
  <% } %>

  <div class="grid mt blocos blocos-dash" data-ordenavel="blocos" aria-label="Gráficos e status">
    <% if (mostra.dre) { %>
    <div class="card col-4" data-ordem-chave="tendencia">
      <div class="card-head"><h2>Receita líquida x Lucro líquido</h2><span class="hint">Últimos 12 períodos (DRE)</span></div>
      <div class="chart-box"><canvas id="chart-trend" aria-label="Evolução de receita e lucro"></canvas></div>
    </div>
    <% } %>
    <% if (mostra.bp) { %>
    <div class="card col-2" data-ordem-chave="bp">
      <div class="card-head"><h2>Balanço por grupo</h2><span class="hint">BP</span></div>
      <div class="chart-box"><canvas id="chart-bp" aria-label="Balanço por grupo"></canvas></div>
    </div>
    <% } %>
    <% if (mostra.clientes) { %>
    <div class="card col-3" data-ordem-chave="aging-receber">
      <div class="card-head"><h2>Aging · contas a receber</h2><a class="hint" href="/modulos/clientes">Ver clientes →</a></div>
      <div class="chart-box"><canvas id="chart-ar" aria-label="Aging contas a receber"></canvas></div>
    </div>
    <% } %>
    <% if (mostra.fornecedores) { %>
    <div class="card col-3" data-ordem-chave="aging-pagar">
      <div class="card-head"><h2>Aging · contas a pagar</h2><a class="hint" href="/modulos/fornecedores">Ver fornecedores →</a></div>
      <div class="chart-box"><canvas id="chart-ap" aria-label="Aging contas a pagar"></canvas></div>
    </div>
    <% } %>

  <div class="card col-6" data-ordem-chave="status">
    <div class="card-head">
      <h2>Status da carga · <%= fmt.periodFull(filter.periodo) %></h2>
      <span class="hint"><%= totalCompanies %> empresa(s) cadastrada(s)</span>
    </div>
    <div class="status-grid">
      <% status.forEach(s => { %>
        <a class="status-item <%= s.companies ? '' : 'off' %>" href="/modulos/<%= s.slug %>">
          <%- include('../partials/icon', { name: s.icon }) %>
          <span class="name"><%= s.title %></span>
          <% if (s.companies) { %>
            <span class="badge ok" title="<%= fmt.number(s.rows) %> linhas"><%= s.companies %>/<%= totalCompanies %></span>
          <% } else { %>
            <span class="badge missing">Pendente</span>
          <% } %>
        </a>
      <% }) %>
    </div>
  </div>
  </div><%# fim do grupo reordenável %>
<% } %>

<%- include('../partials/layout-end') %>
