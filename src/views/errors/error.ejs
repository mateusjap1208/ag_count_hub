<%- include('../partials/head', { title: 'Erro ' + status }) %>
<div class="error-page">
  <div>
    <% if (status >= 500) { %>
      <%- include('../partials/obra-animacao') %>
      <p class="error-obra">Estamos fazendo uma obrinha por aqui. Tente de novo em instantes.</p>
    <% } else { %>
    <img src="/static/img/logo-consag.png" alt="CONSAG Engenharia" class="error-logo logo-pos"><img src="/static/img/logo-consag-negativo.png" alt="CONSAG Engenharia" class="error-logo logo-neg">
    <% } %>
    <div class="code"><%= status %></div>
    <p class="error-msg"><%= message %></p>
    <a class="btn btn-primary" href="<%= locals.user ? '/' : '/login' %>"><%= locals.user ? 'Voltar ao início' : 'Ir para o login' %></a>
  </div>
</div>
</body>
</html>
