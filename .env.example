# Copie este arquivo para .env e ajuste os valores.

PORT=3000
NODE_ENV=development

# Troque por um valor longo e aleatório em produção
SESSION_SECRET=troque-esta-chave-por-um-valor-aleatorio

# Usuário administrador criado pelo "npm run seed" (apenas para testes locais)
ADMIN_EMAIL=admin@agconthub.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Persistência: "json" (cache local) ou "mongo" (MongoDB Atlas)
# Passo a passo: 1) preencha MONGODB_URI  2) npm run mongo:migrate  3) troque para STORAGE_DRIVER=mongo
STORAGE_DRIVER=json
DATA_DIR=./data
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=ag-cont-hub
MONGODB_DB=ag_cont_hub

# Upload
UPLOAD_MAX_MB=50

# FGI0: contas desconsideradas pelo primeiro dígito (separe por vírgula)
FGI0_IGNORAR_PREFIXOS=6,9
